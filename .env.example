# ============================================================
# ONLINE COACHING PLATFORM — ENVIRONMENT CONFIGURATION EXAMPLE
# ============================================================

# MongoDB Atlas Connection URI
# Copy this file to .env and put your MongoDB Atlas connection string below:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/coaching_db?retryWrites=true&w=majority

# MongoDB Database Name
DB_NAME=coaching_db

# Local Development Port
PORT=5000

# Authentication & Security Keys
JWT_SECRET=supersecretcoachingkey2026

# Owner / Admin Access Passcode
ADMIN_PASSCODE=admin123
